{
  "name": "remote-health",
  "displayName": "Remote Health",
  "publisher": "bacojam",
  "description": "Lightweight health metrics for local, Remote-SSH, and dev container environments",
  "version": "0.0.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/bacojam/remote-health.git"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:remote-health.refresh"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "remote-health.refresh",
        "title": "Remote Health: Refresh Now",
        "icon": "$(refresh)"
      }
    ],
    "configuration": {
      "title": "Remote Health",
      "properties": {
        "remoteHealth.pollIntervalSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 2,
          "maximum": 300,
          "description": "Seconds between CPU, memory, and network samples."
        },
        "remoteHealth.displayMode": {
          "type": "string",
          "enum": [
            "icon",
            "compact",
            "detailed"
          ],
          "default": "compact",
          "description": "Amount of information shown in the status bar."
        },
        "remoteHealth.alerts.flash": {
          "type": "boolean",
          "default": true,
          "description": "Alternate the status bar warning color while a metric is unhealthy."
        },
        "remoteHealth.alerts.consecutiveSamples": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 12,
          "description": "Consecutive unhealthy samples required before alerting (battery alerts immediately)."
        },
        "remoteHealth.thresholds.cpuPercent": {
          "type": "number",
          "default": 85,
          "minimum": 1,
          "maximum": 100
        },
        "remoteHealth.thresholds.memoryPercent": {
          "type": "number",
          "default": 85,
          "minimum": 1,
          "maximum": 100
        },
        "remoteHealth.thresholds.batteryPercent": {
          "type": "number",
          "default": 25,
          "minimum": 0,
          "maximum": 100
        },
        "remoteHealth.thresholds.temperatureCelsius": {
          "type": "number",
          "default": 85,
          "minimum": 1,
          "maximum": 150
        },
        "remoteHealth.thresholds.diskPercent": {
          "type": "number",
          "default": 90,
          "minimum": 1,
          "maximum": 100
        },
        "remoteHealth.agent.socketPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional Unix socket for an external host agent mounted into this environment. Requires agent.tokenFilePath."
        },
        "remoteHealth.agent.tokenFilePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Path to the mounted file containing the external agent token. The token is never stored in VS Code settings."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "package:vsix": "npm run package && vsce package",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.6.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
